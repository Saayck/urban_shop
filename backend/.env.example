SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/urban_shop_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin

# Generate a unique Base64-encoded secret containing at least 32 random bytes.
JWT_SECRET=replace-with-a-base64-encoded-256-bit-secret
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=urban-shop-backend

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable only for the first local setup, then disable it.
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FULL_NAME=Super Administrador
