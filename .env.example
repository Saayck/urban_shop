# Plantilla de variables de entorno de Urban Shop.
#
#   cp .env.example .env
#
# Luego reemplaza TODOS los valores marcados como CAMBIAR. El archivo .env real
# esta en .gitignore y nunca debe versionarse.
# docker compose lo carga automaticamente desde la raiz del repositorio.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
POSTGRES_DB=urban_shop_dev
POSTGRES_USER=postgres
# CAMBIAR: contrasena de PostgreSQL. Sin ella la aplicacion no arranca.
POSTGRES_PASSWORD=cambiar-esta-contrasena

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# CAMBIAR: clave de firma de los JWT. Debe ser Base64 y de al menos 32 bytes.
# Generala con:  openssl rand -base64 48
JWT_SECRET=cambiar-por-una-clave-base64-de-al-menos-32-bytes
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=urban-shop-backend

# Origenes permitidos por CORS, separados por coma (el frontend).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Webhook de pagos
# ---------------------------------------------------------------------------
# CAMBIAR: secreto compartido con la pasarela. Debe coincidir con el que ella
# usa para firmar. Si queda vacio, /api/payments/webhook rechaza todo.
# Generalo con:  openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET=cambiar-por-el-secreto-de-la-pasarela
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
# Con MAIL_ENABLED=false los correos se escriben en el log en vez de enviarse.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Archivos subidos
# ---------------------------------------------------------------------------
STORAGE_LOCATION=/app/uploads
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB

# ---------------------------------------------------------------------------
# Super admin inicial
# ---------------------------------------------------------------------------
# Ponlo en true solo la primera vez, para crear el SUPER_ADMIN. Despues
# vuelvelo a false para que no se recree en cada arranque.
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FULL_NAME=Super Administrador
